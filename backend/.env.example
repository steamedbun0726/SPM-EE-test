# 服务器
PORT=3000

# 数据库：sqlite（默认，零配置）| postgres
DB_TYPE=sqlite
DB_HOST=localhost
DB_PORT=5432
DB_USER=campushub
DB_PASSWORD=campushub
DB_NAME=campushub
DB_SYNCHRONIZE=false

# JWT
JWT_SECRET=change-me-in-production-please
JWT_EXPIRES_IN=7d

# 业务参数（可在运行时通过 SystemConfig 覆盖）
BOOKING_MAX_HOURS=4
BOOKING_MINUTE_UNIT=60
NO_SHOW_GRACE_MINUTES=15
REMINDER_BEFORE_MINUTES=15
REMINDER_AFTER_MINUTES=10
ROOM_APPROVAL_TIMEOUT_HOURS=2
WORKORDER_SLA_HOURS=48
