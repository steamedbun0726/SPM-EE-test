page {
  background: #f5f7fb;
  color: #1f2430;
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', sans-serif;
}

.container {
  padding: 24rpx;
}

.card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(31, 36, 48, 0.05);
}

.muted {
  color: #8a94a6;
  font-size: 24rpx;
}

.btn-primary {
  background: #2b6cff;
  color: #ffffff;
  border-radius: 14rpx;
  font-size: 30rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-weight: 600;
}

.btn-primary[disabled] {
  background: #b7c9ff;
  color: #ffffff;
}

button::after {
  border: none;
}

.empty {
  text-align: center;
  color: #8a94a6;
  font-size: 26rpx;
  padding: 56rpx 28rpx;
}
